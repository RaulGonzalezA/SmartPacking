# Copia este archivo como .env y sustituye los valores de ejemplo.
# .env contiene secretos locales y no se versiona.

POSTGRES_DB=smartpacking
POSTGRES_USER=smartpacking
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-local-redis-password

# Clave de desarrollo que utiliza Azurite. No usar en Azure real.
AZURITE_ACCOUNT_KEY=replace-with-the-azurite-development-key

# Configuración de Auth0. Solo ClientSecret es confidencial.
ASPNETCORE_ENVIRONMENT=Production
AUTHENTICATION_ENABLED=true
AUTH0_AUTHORITY=https://YOUR_TENANT.eu.auth0.com/
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_CLIENT_ID=replace-with-your-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-your-auth0-client-secret
