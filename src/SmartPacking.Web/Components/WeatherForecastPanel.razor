@using SmartPacking.Application
@using System.Globalization

@if (Forecast is not null)
{
    <section class="family-section weather-panel">
        <div class="weather-heading"><div><p class="type">Previsión del viaje</p><h2>@Forecast.Destination</h2><p class="muted">@Forecast.StartDate.ToString("d", CultureInfo.CurrentCulture) – @Forecast.EndDate.ToString("d", CultureInfo.CurrentCulture)</p></div><div class="weather-range"><span>Temperatura prevista</span><strong>@Forecast.MinimumCelsius°–@Forecast.MaximumCelsius°</strong></div></div>
        <div class="weather-overview" aria-label="Resumen meteorológico"><div><span aria-hidden="true">🌡️</span><strong>@Forecast.MinimumCelsius°–@Forecast.MaximumCelsius°</strong><small>mínima y máxima</small></div><div><span aria-hidden="true">☔</span><strong>@Forecast.RainProbability%</strong><small>lluvia máxima</small></div><div><span aria-hidden="true">📅</span><strong>@Forecast.Daily.Count</strong><small>días previstos</small></div></div>
        <div class="weather-days">
            @foreach (var day in Forecast.Daily)
            {
                var condition = Condition(day.WeatherCode);
                <article class="weather-day"><div class="weather-day-title"><span class="weather-icon" role="img" aria-label="@condition.Label">@condition.Icon</span><div><strong>@day.Date.ToString("ddd d", CultureInfo.CurrentCulture)</strong><span>@condition.Label</span></div></div><div class="weather-temperatures"><strong>@day.MinimumCelsius° <span>/</span> @day.MaximumCelsius°</strong><small>Sensación: @day.ApparentMinimumCelsius–@day.ApparentMaximumCelsius°</small></div><div class="weather-details"><span>💨 @day.WindSpeedKilometresPerHour km/h</span><span>☔ @day.RainProbability%</span></div></article>
            }
        </div>
    </section>
}

@code {
    [Parameter] public TripWeatherForecast? Forecast { get; set; }
    private static (string Icon, string Label) Condition(int code) => code switch { 0 => ("☀️", "Soleado"), 1 or 2 => ("🌤️", "Parcialmente nublado"), 3 => ("☁️", "Nublado"), 45 or 48 => ("🌫️", "Niebla"), >= 51 and <= 67 or >= 80 and <= 82 => ("🌧️", "Lluvia"), >= 71 and <= 77 or >= 85 and <= 86 => ("🌨️", "Nieve"), >= 95 => ("⛈️", "Tormenta"), _ => ("🌥️", "Variable") };
}
