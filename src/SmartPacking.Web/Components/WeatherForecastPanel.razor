@using SmartPacking.Application
@using System.Globalization

@if (Forecast is not null)
{
    <section class="family-section">
        <h2>Previsión diaria</h2>
        <p class="muted">@Forecast.Destination · @Forecast.MinimumCelsius–@Forecast.MaximumCelsius °C · lluvia máxima @Forecast.RainProbability%</p>
        <div class="weather-days">
            @foreach (var day in Forecast.Daily)
            {
                var condition = Condition(day.WeatherCode);
                <article class="weather-day"><span class="weather-icon" role="img" aria-label="@condition.Label">@condition.Icon</span><div><strong>@day.Date.ToString("ddd d", CultureInfo.CurrentCulture)</strong><span>@condition.Label</span></div><div class="weather-temperatures">@day.MinimumCelsius° / @day.MaximumCelsius°<small>🌡️ @day.ApparentMinimumCelsius–@day.ApparentMaximumCelsius° · 💨 @day.WindSpeedKilometresPerHour km/h</small><small>☔ @day.RainProbability%</small></div></article>
            }
        </div>
    </section>
}

@code {
    [Parameter] public TripWeatherForecast? Forecast { get; set; }
    private static (string Icon, string Label) Condition(int code) => code switch { 0 => ("☀️", "Soleado"), 1 or 2 => ("🌤️", "Parcialmente nublado"), 3 => ("☁️", "Nublado"), 45 or 48 => ("🌫️", "Niebla"), >= 51 and <= 67 or >= 80 and <= 82 => ("🌧️", "Lluvia"), >= 71 and <= 77 or >= 85 and <= 86 => ("🌨️", "Nieve"), >= 95 => ("⛈️", "Tormenta"), _ => ("🌥️", "Variable") };
}
