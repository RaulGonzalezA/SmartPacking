@using System.Globalization

@if (IsActive)
{
    <section class="controls"><label>Viaje activo <select value="@SelectedTripId" @onchange="SelectTrip"><option value="@Guid.Empty">Selecciona un viaje</option>@foreach (var trip in Trips) { <option value="@trip.Id">@trip.Destination · @trip.StartDate.ToString("d", CultureInfo.CurrentCulture)</option> }</select></label><button type="button" disabled="@IsBusy" @onclick="() => showTripForm = !showTripForm">Nuevo viaje</button><button type="button" disabled="@(IsBusy || SelectedTripId == Guid.Empty)" @onclick="StartEditingTrip">Editar viaje</button><button type="button" class="danger" disabled="@(IsBusy || SelectedTripId == Guid.Empty)" @onclick="RequestTripDeletion">Eliminar viaje</button></section>
    @if (confirmTripDeletion) { <div class="feedback" role="alertdialog"><p>¿Eliminar este viaje? Esta acción no se puede deshacer.</p><button type="button" disabled="@IsBusy" class="danger" @onclick="ConfirmTripDeletionAsync">Eliminar</button><button type="button" disabled="@IsBusy" @onclick="CancelConfirmation">Cancelar</button></div> }
    @if (showTripForm) { <TripEditor Input="newTrip" IsBusy="IsBusy" Templates="Templates" Title="Nuevo viaje" SubmitLabel="Crear viaje" Submitted="() => Created.InvokeAsync(newTrip)" TemplateChanged="ApplyTemplate" /> }
    @if (editingTrip is not null) { <TripEditor Input="editTrip" IsBusy="IsBusy" Templates="Templates" Title="Editar viaje" SubmitLabel="Guardar cambios" Submitted="SaveTrip" Cancelled="CancelEditingTrip" /> }
    <section class="family-section"><h2>Viajeros</h2><p class="muted">Cada viajero conserva su propia maleta.</p><div class="quick-form"><label>Nuevo viajero <InputText @bind-Value="newTravellerName" placeholder="Nombre" /></label><label>Notas de equipaje <InputText @bind-Value="newTravellerPackingNotes" /></label><label>Salud y medicación <InputText @bind-Value="newTravellerMedicalNotes" /></label><button type="button" disabled="@IsBusy" @onclick="AddTraveller">Añadir viajero</button></div><div class="profile-items">@foreach (var profile in Profiles.Where(profile => !profile.IsArchived)) { <label class="profile-item"><input disabled="@IsBusy" type="checkbox" checked="@tripProfileIds.Contains(profile.Id)" @onchange="args => SetTraveller(profile.Id, args.Value is bool selected && selected)" /> @profile.Name <button type="button" disabled="@IsBusy" @onclick="() => StartEditingTraveller(profile)">Editar</button>@if (profile.Id != DefaultProfileId) { <button type="button" disabled="@IsBusy" class="danger" @onclick="() => RequestTravellerArchive(profile.Id)">Archivar</button> }</label> }</div><button type="button" disabled="@IsBusy" @onclick="SaveTravellers">Guardar viajeros</button>@if (editingTraveller is not null) { <EditForm Model="editingTraveller" OnValidSubmit="SaveTraveller" class="quick-form"><label>Nombre <InputText @bind-Value="editingTravellerName" /></label><label>Notas de equipaje <InputText @bind-Value="editingTravellerPackingNotes" /></label><label>Salud y medicación <InputText @bind-Value="editingTravellerMedicalNotes" /></label><button disabled="@IsBusy">Guardar viajero</button><button type="button" disabled="@IsBusy" @onclick="CancelEditingTraveller">Cancelar</button></EditForm> }</section>
    @if (Trips.Count == 0) { <p class="muted">Crea un viaje para empezar a organizarlo.</p> }<WeatherForecastPanel Forecast="Weather" />
    @if (IsCompleted) { <section class="family-section"><h2>Después del viaje</h2><div class="profile-items">@foreach (var item in Wardrobe.Where(item => UsageItemIds.Contains(item.Id))) { <label class="profile-item"><input disabled="@IsBusy" type="checkbox" checked="@usedItemIds.Contains(item.Id)" @onchange="args => SetUsage(item.Id, args.Value is bool used && used)" /> @item.Name</label> }</div><button type="button" disabled="@IsBusy" @onclick="SaveUsage">Guardar uso real</button></section> } else if (SelectedTripId != Guid.Empty) { <p class="muted">@WeatherUnavailableMessage</p> }
}
