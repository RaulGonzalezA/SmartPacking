@using System.Globalization

@if (IsActive)
{
    <section class="controls"><label>Viaje activo <select value="@SelectedTripId" @onchange="SelectTrip"><option value="@Guid.Empty">Selecciona un viaje</option>@foreach (var trip in Trips) { <option value="@trip.Id">@trip.Destination · @trip.StartDate.ToString("d", CultureInfo.CurrentCulture)</option> }</select></label><button disabled="@IsBusy" @onclick="() => showTripForm = !showTripForm">Nuevo viaje</button><button disabled="@(IsBusy || SelectedTripId == Guid.Empty)" @onclick="StartEditingTrip">Editar viaje</button><button class="danger" disabled="@(IsBusy || SelectedTripId == Guid.Empty)" @onclick="RequestTripDeletion">Eliminar viaje</button></section>
    @if (confirmTripDeletion) { <div class="feedback" role="alertdialog"><p>¿Eliminar este viaje? Esta acción no se puede deshacer.</p><button disabled="@IsBusy" class="danger" @onclick="ConfirmTripDeletionAsync">Eliminar</button><button disabled="@IsBusy" @onclick="CancelConfirmation">Cancelar</button></div> }
    @if (showTripForm) { <EditForm Model="newTrip" OnValidSubmit="() => Created.InvokeAsync(newTrip)" class="entry-form"><DataAnnotationsValidator /><label>Plantilla <select disabled="@IsBusy" @bind="newTrip.TemplateKey" @bind:after="ApplyTemplate"><option value="">Personalizado</option>@foreach (var template in Templates) { <option value="@template.Key">@template.Name</option> }</select></label><label>Destino <InputText @bind-Value="newTrip.Destination" /></label><label>Salida <InputDate @bind-Value="newTrip.StartDate" /></label><label>Regreso <InputDate @bind-Value="newTrip.EndDate" /></label><label>Mínima °C <InputNumber @bind-Value="newTrip.MinimumTemperatureCelsius" /></label><label>Máxima °C <InputNumber @bind-Value="newTrip.MaximumTemperatureCelsius" /></label><label>Límite de peso (g) <InputNumber @bind-Value="newTrip.LuggageAllowanceGrams" /></label><label><InputCheckbox @bind-Value="newTrip.CabinOnly" /> Solo equipaje de cabina</label><button disabled="@IsBusy">Crear viaje</button></EditForm> }
    @if (editingTrip is not null) { <EditForm Model="editTrip" OnValidSubmit="SaveTrip" class="entry-form"><DataAnnotationsValidator /><label>Destino <InputText @bind-Value="editTrip.Destination" /></label><label>Salida <InputDate @bind-Value="editTrip.StartDate" /></label><label>Regreso <InputDate @bind-Value="editTrip.EndDate" /></label><label>Mínima °C <InputNumber @bind-Value="editTrip.MinimumTemperatureCelsius" /></label><label>Máxima °C <InputNumber @bind-Value="editTrip.MaximumTemperatureCelsius" /></label><label>Límite de peso (g) <InputNumber @bind-Value="editTrip.LuggageAllowanceGrams" /></label><label><InputCheckbox @bind-Value="editTrip.CabinOnly" /> Solo equipaje de cabina</label><button disabled="@IsBusy">Guardar cambios</button><button type="button" disabled="@IsBusy" @onclick="CancelEditingTrip">Cancelar</button></EditForm> }
    <section class="family-section"><h2>Viajeros</h2><p class="muted">Cada viajero conserva su propia maleta.</p><div class="quick-form"><label>Nuevo viajero <InputText @bind-Value="newTravellerName" placeholder="Nombre" /></label><label>Notas de equipaje <InputText @bind-Value="newTravellerPackingNotes" placeholder="Ej. necesita gafas" /></label><label>Salud y medicación <InputText @bind-Value="newTravellerMedicalNotes" placeholder="Opcional" /></label><button disabled="@IsBusy" @onclick="AddTraveller">Añadir viajero</button></div><div class="profile-items">@foreach (var profile in Profiles.Where(profile => !profile.IsArchived)) { <label class="profile-item"><input disabled="@IsBusy" type="checkbox" checked="@tripProfileIds.Contains(profile.Id)" @onchange="args => SetTraveller(profile.Id, args.Value)" /> @profile.Name <button disabled="@IsBusy" type="button" @onclick="() => StartEditingTraveller(profile)">Editar</button>@if (profile.Id != DefaultProfileId) { <button disabled="@IsBusy" type="button" class="danger" @onclick="() => RequestTravellerArchive(profile.Id)">Archivar</button> }</label> }</div><button disabled="@IsBusy" @onclick="SaveTravellers">Guardar viajeros</button>@if (confirmTravellerArchiveId is Guid) { <div class="feedback" role="alertdialog"><p>¿Archivar este viajero?</p><button disabled="@IsBusy" class="danger" @onclick="ConfirmTravellerArchiveAsync">Archivar</button><button disabled="@IsBusy" @onclick="CancelConfirmation">Cancelar</button></div> }@if (editingTraveller is not null) { <div class="quick-form"><label>Nombre <InputText @bind-Value="editingTravellerName" /></label><label>Notas de equipaje <InputText @bind-Value="editingTravellerPackingNotes" /></label><label>Salud y medicación <InputText @bind-Value="editingTravellerMedicalNotes" /></label><button disabled="@IsBusy" @onclick="SaveTraveller">Guardar viajero</button><button disabled="@IsBusy" type="button" @onclick="CancelEditingTraveller">Cancelar</button></div> }</section>
    @if (Trips.Count == 0) { <p class="muted">Crea un viaje para empezar a organizarlo.</p> }<WeatherForecastPanel Forecast="Weather" />
    @if (IsCompleted) { <section class="family-section"><h2>Después del viaje</h2><p class="muted">Marca las prendas que realmente usaste; mejorará tus próximas recomendaciones.</p><div class="profile-items">@foreach (var item in Wardrobe.Where(item => UsageItemIds.Contains(item.Id))) { <label class="profile-item"><input disabled="@IsBusy" type="checkbox" checked="@usedItemIds.Contains(item.Id)" @onchange="args => SetUsage(item.Id, args.Value)" /> @item.Name</label> }</div><button disabled="@IsBusy" @onclick="SaveUsage">Guardar uso real</button></section> } else if (SelectedTripId != Guid.Empty) { <p class="muted">@WeatherUnavailableMessage</p> }
}
