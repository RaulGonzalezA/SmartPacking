@using System.Globalization

@if (IsActive)
{
    var selectedTrip = Trips.SingleOrDefault(trip => trip.Id == SelectedTripId);
    <section class="trip-dashboard">
        <div class="trip-dashboard-top"><label class="trip-selector"><span>Viaje activo</span><select value="@SelectedTripId" @onchange="SelectTrip"><option value="@Guid.Empty">Selecciona un viaje</option>@foreach (var trip in Trips) { <option value="@trip.Id">@trip.Destination · @trip.StartDate.ToString("d", CultureInfo.CurrentCulture)</option> }</select></label><button type="button" disabled="@IsBusy" @onclick="() => showTripForm = !showTripForm">+ Nuevo viaje</button></div>
        @if (selectedTrip is not null) { <div class="trip-dashboard-content"><div><p class="type">Próxima escapada</p><h1>@selectedTrip.Destination</h1><p class="trip-dates">@selectedTrip.StartDate.ToString("d MMMM", CultureInfo.CurrentCulture) – @selectedTrip.EndDate.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)</p><div class="trip-facts"><span>📍 Desde @(selectedTrip.Origin ?? "origen por confirmar")</span><span>@TransportSummary(selectedTrip)</span><span>👤 @TripProfiles.Count viajero@(TripProfiles.Count == 1 ? string.Empty : "s")</span></div></div><div class="trip-dashboard-side"><strong>☀️ @selectedTrip.MinimumTemperatureCelsius° – @selectedTrip.MaximumTemperatureCelsius°</strong><span>@selectedTrip.Days días</span><details class="action-menu"><summary aria-label="Más acciones del viaje">⋮</summary><div><button type="button" disabled="@IsBusy" @onclick="StartEditingTrip">Editar viaje</button><button type="button" class="danger" disabled="@IsBusy" @onclick="RequestTripDeletion">Eliminar viaje</button></div></details></div></div> }
    </section>
    @if (confirmTripDeletion) { <div class="feedback" role="alertdialog"><p>¿Eliminar este viaje? Esta acción no se puede deshacer.</p><button type="button" disabled="@IsBusy" class="danger" @onclick="ConfirmTripDeletionAsync">Eliminar</button><button type="button" disabled="@IsBusy" @onclick="CancelConfirmation">Cancelar</button></div> }
    @if (showTripForm) { <TripEditor Input="newTrip" IsBusy="IsBusy" Templates="Templates" Title="Nuevo viaje" SubmitLabel="Crear viaje" Submitted="CreateTrip" TemplateChanged="ApplyTemplate" /> }
    @if (editingTrip is not null) { <TripEditor Input="editTrip" IsBusy="IsBusy" Templates="Templates" Title="Editar viaje" SubmitLabel="Guardar cambios" Submitted="SaveTrip" Cancelled="CancelEditingTrip" /> }
    <section class="family-section travellers-section"><header class="section-heading"><div><p class="type">Quién viaja</p><h2>Viajeros</h2><p class="muted">Cada viajero conserva su propia maleta.</p></div><button type="button" disabled="@IsBusy" @onclick="OpenTravellerForm">+ Añadir viajero</button></header><div class="traveller-cards">@foreach (var profile in Profiles.Where(profile => !profile.IsArchived)) { <article class="traveller-card"><span aria-hidden="true">👤</span><div><h3>@profile.Name</h3><p>🧳 Maleta individual</p><small>@(tripProfileIds.Contains(profile.Id) ? "✅ Incluido en este viaje" : "No incluido en este viaje")</small></div><label class="switch"><input disabled="@IsBusy" type="checkbox" checked="@tripProfileIds.Contains(profile.Id)" @onchange="args => SetTraveller(profile.Id, args.Value is bool selected && selected)" /><span>Viaja</span></label><button type="button" class="secondary" disabled="@IsBusy" @onclick="() => StartEditingTraveller(profile)">Editar →</button></article> }</div><button type="button" disabled="@IsBusy" @onclick="SaveTravellers">Guardar viajeros</button></section>
    @if (showTravellerForm || editingTraveller is not null) { <div class="ui-modal-backdrop"><section class="ui-modal" role="dialog" aria-modal="true"><header><div><p class="type">Viajero</p><h2>@(editingTraveller is null ? "Añadir viajero" : "Editar viajero")</h2></div><button type="button" class="icon-button" @onclick="CancelTravellerDialog" aria-label="Cerrar">×</button></header><EditForm Model="editingTraveller" OnValidSubmit="SaveTravellerDialog" class="modal-form"><label>Nombre <InputText @bind-Value="CurrentTravellerName" /></label><label>Notas de equipaje <InputText @bind-Value="CurrentTravellerPackingNotes" /></label><label>Salud y medicación <InputText @bind-Value="CurrentTravellerMedicalNotes" /></label><footer><button type="button" class="secondary" @onclick="CancelTravellerDialog">Cancelar</button><button disabled="@IsBusy">Guardar viajero</button></footer></EditForm></section></div> }
    @if (Trips.Count == 0) { <p class="muted">Crea un viaje para empezar a organizarlo.</p> }<WeatherForecastPanel Forecast="Weather" />
    @if (IsCompleted) { <section class="family-section"><h2>Después del viaje</h2><div class="profile-items">@foreach (var item in Wardrobe.Where(item => UsageItemIds.Contains(item.Id))) { <label class="profile-item"><input disabled="@IsBusy" type="checkbox" checked="@usedItemIds.Contains(item.Id)" @onchange="args => SetUsage(item.Id, args.Value is bool used && used)" /> @item.Name</label> }</div><button type="button" disabled="@IsBusy" @onclick="SaveUsage">Guardar uso real</button></section> } else if (SelectedTripId != Guid.Empty) { <p class="muted">@WeatherUnavailableMessage</p> }
}
