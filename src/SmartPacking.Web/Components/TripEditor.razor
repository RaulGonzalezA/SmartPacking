@using SmartPacking.Application
@using SmartPacking.Domain

<EditForm Model="Input" OnValidSubmit="() => Submitted.InvokeAsync()" class="entry-form trip-editor trip-wizard">
    <DataAnnotationsValidator />
    <header class="wizard-heading"><div><p class="type">Planifica sin perderte</p><h2>@Title</h2></div><p class="muted">Abre cada paso para revisar o completar sus detalles.</p></header>
    <details class="wizard-step" open><summary><span>1</span><div><strong>Información del viaje</strong><small>@(string.IsNullOrWhiteSpace(Input.Destination) ? "Destino y fechas" : $"{Input.Destination} · {Input.StartDate:d} – {Input.EndDate:d}")</small></div></summary><div class="wizard-step-content"><label>Plantilla <select disabled="@IsBusy" @bind="Input.TemplateKey" @bind:after="() => TemplateChanged.InvokeAsync()"><option value="">Personalizado</option>@foreach (var template in Templates) { <option value="@template.Key">@template.Name</option> }</select></label><label class="city-autocomplete">Destino <input value="@Input.Destination" @oninput="SetDestination" @onfocus="() => activeCityField = CityField.Destination" placeholder="Escribe una ciudad" autocomplete="off" />@if (activeCityField == CityField.Destination) { <CitySuggestions Query="@Input.Destination" Selected="SelectDestination" /> }<small class="field-hint">Busca por cualquier parte del nombre.</small></label><label class="city-autocomplete">Origen <input value="@Input.Origin" @oninput="SetOrigin" @onfocus="() => activeCityField = CityField.Origin" placeholder="Ej. Ocaña, Toledo" autocomplete="off" />@if (activeCityField == CityField.Origin) { <CitySuggestions Query="@Input.Origin" Selected="SelectOrigin" /> }<small class="field-hint">Tu ciudad o punto de salida.</small></label><label>Salida <InputDate @bind-Value="Input.StartDate" /></label><label>Regreso <InputDate @bind-Value="Input.EndDate" /></label></div></details>
    <details class="wizard-step"><summary><span>2</span><div><strong>Transporte</strong><small>@TransportSummary()</small></div></summary><div class="wizard-step-content"><p class="muted">Opciones orientativas según origen y destino. Confirma horarios y disponibilidad antes de reservar.</p><div class="transport-chips">@foreach (var option in TransportAdvisor.GetOptions(Input.Origin, Input.Destination)) { var transport = option.Type; <label class="@(Input.TransportTypes.Contains(transport) ? "selected" : string.Empty) @(option.IsAvailable ? string.Empty : "unavailable")" title="@option.Reason"><input type="checkbox" disabled="@(IsBusy || !option.IsAvailable)" checked="@Input.TransportTypes.Contains(transport)" @onchange="args => Input.SetTransport(transport, args.Value is bool selected && selected)" /><span aria-hidden="true">@TransportIcon(transport)</span><b>@TransportName(transport)</b><small>@option.Reason</small></label> }</div></div></details>
    <details class="wizard-step"><summary><span>3</span><div><strong>Equipaje</strong><small>@LuggageSummary()</small></div></summary><div class="wizard-step-content"><div class="luggage-heading"><p class="muted">La aerolínea solo limita las maletas de cabina.</p><button type="button" disabled="@IsBusy" @onclick="Input.AddLuggage">Añadir maleta</button></div>@if (Input.TransportTypes.Contains(TransportType.Plane)) { <label class="airline-select">Aerolínea <select disabled="@IsBusy" @bind="Input.AirlineCode" @bind:after="Input.ApplyAirlineRule"><option value="">Sin aerolínea</option>@foreach (var rule in AirlineLuggageCatalog.All) { <option value="@rule.Code">@rule.Name</option> }</select></label> }@foreach (var luggage in Input.Luggages) { var lockedByAirline = luggage.Type == LuggageType.Cabin && !string.IsNullOrWhiteSpace(Input.AirlineCode); <article class="luggage-card"><div class="luggage-card-title"><span aria-hidden="true">@LuggageIcon(luggage.Type)</span><label>Nombre <InputText @bind-Value="luggage.Name" placeholder="Ej. maleta grande" /></label><button type="button" class="secondary" disabled="@(IsBusy || Input.Luggages.Count == 1)" @onclick="() => Input.RemoveLuggage(luggage)">Quitar</button></div><div class="luggage-fields"><label>Tipo <select disabled="@IsBusy" @bind="luggage.Type" @bind:after="() => Input.ApplyLuggageType(luggage)">@foreach (var type in Enum.GetValues<LuggageType>()) { <option value="@type">@TypeName(type)</option> }</select></label><label>Peso (g) <InputNumber disabled="@(IsBusy || lockedByAirline)" @bind-Value="luggage.AllowanceGrams" /></label><label>Alto (cm) <InputNumber disabled="@(IsBusy || lockedByAirline)" @bind-Value="luggage.HeightCentimetres" /></label><label>Ancho (cm) <InputNumber disabled="@(IsBusy || lockedByAirline)" @bind-Value="luggage.WidthCentimetres" /></label><label>Fondo (cm) <InputNumber disabled="@(IsBusy || lockedByAirline)" @bind-Value="luggage.DepthCentimetres" /></label></div>@if (lockedByAirline) { <small class="luggage-lock">🔒 Medidas aplicadas por la aerolínea seleccionada.</small> }</article> }</div></details>
    <details class="wizard-step"><summary><span>4</span><div><strong>Actividades</strong><small>@(Input.DayPlans.Count == 0 ? "Plan diario pendiente" : $"{Input.DayPlans.Count} días organizados")</small></div></summary><div class="wizard-step-content"><div class="itinerary-editor trip-activities"><div><p class="type">Plan diario</p><h2>Actividades por día</h2><p>Combina hasta tres actividades para reflejar el día real.</p></div><button type="button" disabled="@IsBusy" @onclick="Input.EnsureDayPlans">Generar itinerario diario</button><div class="day-activities-grid">@foreach (var day in Input.DayPlans) { <DayActivitiesEditor Day="day" IsBusy="IsBusy" /> }</div></div></div></details>
    <footer class="wizard-actions"><button disabled="@IsBusy">@SubmitLabel</button>@if (Cancelled.HasDelegate) { <button type="button" class="secondary" disabled="@IsBusy" @onclick="() => Cancelled.InvokeAsync()">Cancelar</button> }</footer>
</EditForm>

@code {
    [Parameter, EditorRequired] public TripFormInput Input { get; set; } = new(); [Parameter, EditorRequired] public string Title { get; set; } = string.Empty; [Parameter, EditorRequired] public string SubmitLabel { get; set; } = string.Empty; [Parameter, EditorRequired] public EventCallback Submitted { get; set; } [Parameter] public EventCallback TemplateChanged { get; set; } [Parameter] public EventCallback Cancelled { get; set; } [Parameter] public bool IsBusy { get; set; } [Parameter] public IReadOnlyList<TripTemplate> Templates { get; set; } = [];
    private static string TypeName(LuggageType type) => type switch { LuggageType.Backpack => "Mochila", LuggageType.Cabin => "Cabina", _ => "Facturada" }; private static string LuggageIcon(LuggageType type) => type switch { LuggageType.Backpack => "🎒", LuggageType.Cabin => "🧳", _ => "🧳" }; private static string TransportName(TransportType type) => type switch { TransportType.Car => "Coche", TransportType.Plane => "Avión", TransportType.Train => "Tren", TransportType.Bus => "Autobús", _ => "Barco" }; private static string TransportIcon(TransportType type) => type switch { TransportType.Car => "🚗", TransportType.Plane => "✈️", TransportType.Train => "🚆", TransportType.Bus => "🚌", _ => "🛳️" };
    private string TransportSummary() => Input.TransportTypes.Count == 0 ? "Selecciona cómo viajarás" : string.Join(" · ", Input.TransportTypes.Select(TransportName)); private string LuggageSummary() => string.Join(" · ", Input.Luggages.Select(luggage => $"{LuggageTypeName(luggage.Type)} {luggage.AllowanceGrams / 1000m:0.#} kg")); private static string LuggageTypeName(LuggageType type) => type switch { LuggageType.Backpack => "Mochila", LuggageType.Cabin => "Cabina", _ => "Facturada" };
    private CityField? activeCityField;
    private void SetDestination(ChangeEventArgs args) { Input.Destination = args.Value?.ToString() ?? string.Empty; activeCityField = CityField.Destination; }
    private void SetOrigin(ChangeEventArgs args) { Input.Origin = args.Value?.ToString(); activeCityField = CityField.Origin; }
    private void SelectDestination(string city) { Input.Destination = city; activeCityField = null; }
    private void SelectOrigin(string city) { Input.Origin = city; activeCityField = null; }
    private enum CityField { Origin, Destination }
}
