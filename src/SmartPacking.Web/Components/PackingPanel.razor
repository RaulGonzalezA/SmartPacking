@if (IsActive && Plan is null)
{
    <section class="family-section"><h2>Maleta</h2><p class="muted">Selecciona un viaje y un viajero para preparar la maleta.</p></section>
}
else if (IsActive && Plan is not null)
{
    <section class="hero"><div><p>@Plan.Plan.Trip.Destination · @Plan.Plan.Trip.Days días</p><h2>Maleta de @Plan.Profile.Name</h2></div></section>
    <section class="traveller-select"><label>Maleta de <select disabled="@IsBusy" value="@SelectedProfileId" @onchange="SelectProfile">@foreach (var profile in TripProfiles) { <option value="@profile.Id">@profile.Name</option> }</select></label></section>
    <PreparationProgressPanel Items="PreparationProgress" /><LuggageRulesPanel Rules="LuggageRules" /><PackingInsightsPanel Insights="Insights" />
    <ToiletryBagPanel Items="Checklist" IsBusy="IsBusy" PackedChanged="ChecklistPackedChanged" Added="ToiletryAdded" />
    <section><div class="section-heading"><h2>Preparar la maleta</h2></div><div class="cards">@foreach (var planned in Plan.Plan.Items) { <article class="card"><label><input disabled="@IsBusy" type="checkbox" checked="@planned.IsPacked" @onchange="args => PackedChanged.InvokeAsync((planned, args.Value is bool packed && packed))" /></label><div><p class="type">@planned.Recommendation.Item.Type · @planned.Recommendation.Score puntos</p><h3>@planned.Recommendation.Item.Name</h3><p class="reason">@(planned.Recommendation.Reasons.Count == 0 ? "Prenda añadida manualmente a esta maleta." : string.Join(" · ", planned.Recommendation.Reasons))</p></div></article> }</div></section>
    <section class="family-section"><h2>Añadir prenda manualmente</h2><div class="quick-form"><label>Prenda <select disabled="@IsBusy" @bind="manualClothingItemId"><option value="@Guid.Empty">Selecciona una prenda</option>@foreach (var item in AvailableManualClothing) { <option value="@item.Id">@item.Name · @(item.WeightGrams ?? 0) g</option> }</select></label><button disabled="@IsBusy" @onclick="AddManualClothing">Añadir a la maleta</button></div></section>
    <PackingChecklist Items="Checklist" OnPackedChanged="ChecklistPackedChanged" />
}
