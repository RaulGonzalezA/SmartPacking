@page "/"
@rendermode InteractiveServer

@if (!authenticationResolved || currentUser is null && emailVerified)
{
    <main><p class="muted" role="status">Cargando tu perfil…</p></main>
}
else if (!emailVerified)
{
    <PendingEmailVerificationPanel Email="@email" />
}
else if (currentUser is { IsOnboarded: false })
{
    <OnboardingPanel IsBusy="State.IsBusy" Feedback="State.Feedback" Completed="CompleteOnboardingAsync" />
}
else if (currentUser is not null)
{
<DashboardShell ActiveTab="State.ActiveTab" ActiveTabChanged="SelectTabAsync" Feedback="@State.Feedback" IsLoading="State.IsLoading" IsBusy="State.IsBusy" ShowAdmin="HasAdminAccess" User="currentUser" Email="email" IsEmailVerified="emailVerified" UserUpdated="UpdateCurrentUserAsync" AccountDeleted="DeleteCurrentUserAsync">
    <TripsPanel IsActive="@(State.ActiveTab == "trips")" IsBusy="State.IsBusy" IsLoading="State.TripsStatus.IsLoading" Feedback="@State.TripsStatus.Feedback" Trips="State.Trips" Profiles="State.Profiles" Templates="State.Templates" TripProfiles="State.TripProfiles" Wardrobe="State.Wardrobe" DefaultOrigin="@DefaultOrigin" SelectedTripId="State.SelectedTripId" SelectedTripChanged="SelectTripAsync" Weather="State.Weather" UsageItemIds="State.UsageItemIds" UsedItemIds="State.UsedItemIds" IsCompleted="@IsSelectedTripCompleted" WeatherUnavailableMessage="@WeatherUnavailableMessage" WeatherRefreshRequested="RefreshWeatherAsync" Created="CreateTripAsync" Updated="SaveTripAsync" Deleted="DeleteTripAsync" TravellersSaved="SaveTravellersAsync" TravellerAdded="AddTravellerAsync" TravellerUpdated="SaveTravellerAsync" Archived="ArchiveTravellerAsync" UsageSaved="SaveUsageAsync" />
    <WardrobePanel @ref="wardrobePanel" IsActive="@(State.ActiveTab == "wardrobe")" IsBusy="State.IsBusy" IsLoading="State.WardrobeStatus.IsLoading" Feedback="@State.WardrobeStatus.Feedback" AiUsage="aiUsage" Items="State.Wardrobe" DeletedItems="State.DeletedWardrobe" Profiles="State.Profiles" Created="CreateClothingAsync" RecognitionRequested="RecognizeGarmentAsync" Changed="UpdateStatusAsync" Removed="id => RunAsync(() => DeleteClothingAsync(id))" Restored="id => RunAsync(() => RestoreClothingAsync(id))" PhotoSelected="UploadClothingPhotoAsync" />
    <PackingPanel IsActive="@(State.ActiveTab == "packing")" IsBusy="State.IsBusy" IsLoading="State.PackingStatus.IsLoading" Feedback="@State.PackingStatus.Feedback" Plan="State.Plan" TripProfiles="State.TripProfiles" SelectedProfileId="State.SelectedProfileId" SelectedProfileChanged="SelectProfileAsync" Wardrobe="State.Wardrobe" Checklist="State.Checklist" PreparationProgress="State.PreparationProgress" LuggageRules="State.LuggageRules" Insights="State.PackingInsights" PackedChanged="SetPackedAsync" ManualClothingAdded="AddManualClothingAsync" ChecklistPackedChanged="SetChecklistPackedAsync" ToiletryAdded="AddToiletryAsync" />
    <AdminPanel IsActive="@(State.ActiveTab == "admin")" CanManageUsers="@HasPermission("admin:users")" CanManagePlans="@HasPermission("admin:plans")" CanManageCredits="@HasPermission("admin:credits")" CanViewAudit="@HasPermission("admin:audit")" CanViewBilling="@HasPermission("admin:billing")" />
</DashboardShell>
}
