<main class="app-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Maleta Inteligente, inicio"><span aria-hidden="true">🧳</span><strong>Maleta Inteligente</strong></a>
        <nav class="tabs primary-nav" aria-label="Secciones">
            @foreach (var tab in Tabs)
            {
                <button class="tab @(ActiveTab == tab.Key ? "active" : "")" disabled="@IsBusy" @onclick="() => ActiveTabChanged.InvokeAsync(tab.Key)">@tab.Value</button>
            }
        </nav>
        <div class="account-actions">
            @if (User is not null)
            {
                <span class="user-name">@User.Name</span>
                <AccountPanel User="User" Email="Email" IsEmailVerified="IsEmailVerified" IsBusy="IsBusy" UserUpdated="UserUpdated" AccountDeleted="AccountDeleted" />
            }
            <a class="logout-link" href="/auth/logout" data-enhance-nav="false">Cerrar sesión</a>
        </div>
    </header>
    @if (!string.IsNullOrWhiteSpace(Feedback))
    {
        <p class="feedback">@Feedback</p>
    }
    @if (IsLoading)
    {
        <p class="muted" role="status">Cargando…</p>
    }
    @ChildContent
</main>

@code {
    private static readonly IReadOnlyDictionary<string, string> Tabs = new Dictionary<string, string>
    {
        ["trips"] = "Viajes",
        ["wardrobe"] = "Armario",
        ["packing"] = "Maleta"
    };

    [Parameter, EditorRequired] public string ActiveTab { get; set; } = "trips";
    [Parameter, EditorRequired] public EventCallback<string> ActiveTabChanged { get; set; }
    [Parameter] public string? Feedback { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public UserProfile? User { get; set; }
    [Parameter] public string? Email { get; set; }
    [Parameter] public bool IsEmailVerified { get; set; }
    [Parameter] public Func<UserProfile, Task<IReadOnlyDictionary<string, string[]>>>? UserUpdated { get; set; }
    [Parameter] public EventCallback AccountDeleted { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
