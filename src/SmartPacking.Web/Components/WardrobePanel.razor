@using SmartPacking.Domain
@using Microsoft.AspNetCore.Components.Forms

@if (IsActive)
{
    <section class="wardrobe">
        <header class="page-section-header">
            <div><p class="type">Tu colección</p><h1>Mi armario</h1><p class="muted">Elige prendas disponibles y mantenlas listas para cada viaje.</p></div>
            <button type="button" disabled="@IsBusy" @onclick="OpenCreate">+ Añadir prenda</button>
        </header>
        <div class="wardrobe-toolbar">
            <label class="search-field"><span aria-hidden="true">⌕</span><input placeholder="Buscar prendas" @bind="search" @bind:event="oninput" /></label>
            <div class="filter-chips" aria-label="Filtrar por tipo"><button class="@(selectedType is null ? "active" : string.Empty)" @onclick="() => selectedType = null">Todo</button>@foreach (var type in Enum.GetValues<ClothingType>()) { <button class="@(selectedType == type ? "active" : string.Empty)" @onclick="() => selectedType = type">@TypeName(type)</button> }</div>
        </div>
        <div class="garment-grid">
            @foreach (var item in GetVisibleItems())
            {
                <button type="button" class="garment-card" @onclick="() => selectedItem = item" aria-label="Ver detalles de @item.Name">
                    @if (photoUrls.TryGetValue(item.Id, out var uploadedPhotoUrl) || !string.IsNullOrWhiteSpace(item.PhotoUrl)) { <img src="@(uploadedPhotoUrl ?? item.PhotoUrl)" alt="@item.Name" /> } else { <span class="garment-placeholder" aria-hidden="true">@GarmentIcon(item.Type)</span> }
                    <span class="garment-details"><strong>@item.Name</strong><small><i style="@ColorStyle(item.Color)"></i>@item.Color</small><small>@TypeName(item.Type) · @item.WeightGrams g</small></span>
                    @if (item.IsClean && item.IsAvailable) { <span class="status-chip ready">Lista</span> } else { <span class="status-chip muted-chip">Revisar</span> }
                </button>
            }
        </div>
        @if (GetVisibleItems().Count == 0) { <p class="empty-state">No hay prendas que coincidan con este filtro.</p> }
    </section>
    @if (DeletedItems.Count > 0) { <details class="archive-section"><summary>Prendas retiradas (@DeletedItems.Count)</summary><div class="archive-items">@foreach (var item in DeletedItems) { <span>@item.Name <button disabled="@IsBusy" @onclick="() => Restored.InvokeAsync(item.Id)">Recuperar</button></span> }</div></details> }
    @if (showForm) { <div class="ui-modal-backdrop" @onclick="CloseCreate"><section class="ui-modal" role="dialog" aria-modal="true" aria-labelledby="new-garment-title" @onclick:stopPropagation="true"><header><div><p class="type">Nuevo artículo</p><h2 id="new-garment-title">Añadir prenda</h2></div><button type="button" class="icon-button" @onclick="CloseCreate" aria-label="Cerrar">×</button></header><EditForm Model="input" OnValidSubmit="SaveAsync" class="modal-form"><label>Nombre <InputText @bind-Value="input.Name" /></label><label>Propietario <select @bind="input.OwnerId">@foreach (var profile in Profiles.Where(profile => !profile.IsArchived)) { <option value="@profile.Id">@profile.Name</option> }</select></label><label>Tipo <select @bind="input.Type" @bind:after="ApplyDefaultWeight">@foreach (var type in Enum.GetValues<ClothingType>()) { <option value="@type">@TypeName(type)</option> }</select></label><label>Color <InputText @bind-Value="input.Color" /></label><label>Peso aproximado (g) <InputNumber @bind-Value="input.WeightGrams" /></label><footer><button type="button" class="secondary" @onclick="CloseCreate">Cancelar</button><button disabled="@IsBusy">Guardar prenda</button></footer></EditForm></section></div> }
    @if (selectedItem is not null) { var item = selectedItem; <div class="ui-modal-backdrop" @onclick="CloseDetails"><section class="ui-modal garment-modal" role="dialog" aria-modal="true" aria-labelledby="garment-detail-title" @onclick:stopPropagation="true"><header><div><p class="type">@TypeName(item.Type)</p><h2 id="garment-detail-title">@item.Name</h2></div><button type="button" class="icon-button" @onclick="CloseDetails" aria-label="Cerrar">×</button></header><div class="garment-detail-content">@if (photoUrls.TryGetValue(item.Id, out var uploadedPhotoUrl) || !string.IsNullOrWhiteSpace(item.PhotoUrl)) { <img src="@(uploadedPhotoUrl ?? item.PhotoUrl)" alt="@item.Name" /> } else { <span class="garment-detail-placeholder" aria-hidden="true">@GarmentIcon(item.Type)</span> }<dl><div><dt>Color</dt><dd>@item.Color</dd></div><div><dt>Peso</dt><dd>@item.WeightGrams g</dd></div><div><dt>Temporada</dt><dd>@item.Season</dd></div><div><dt>Propietario</dt><dd>@OwnerName(item.OwnerProfileId)</dd></div></dl><div class="garment-toggles"><label><input type="checkbox" checked="@item.IsClean" @onchange="args => ChangeItemAsync(item, args.Value is bool value && value, item.IsAvailable)" /> Limpia</label><label><input type="checkbox" checked="@item.IsAvailable" @onchange="args => ChangeItemAsync(item, item.IsClean, args.Value is bool value && value)" /> Disponible</label></div><label class="photo-upload">Actualizar foto <InputFile OnChange="file => UploadPhotoAsync(item.Id, file)" accept="image/jpeg" /></label><button disabled="@IsBusy" class="danger" @onclick="() => RequestRemoval(item.Id)">Retirar del armario</button></div></section></div> }
    @if (pendingRemovalId is Guid) { <div class="ui-modal-backdrop"><section class="ui-modal confirmation-modal" role="alertdialog"><h2>¿Retirar esta prenda?</h2><p>Podrás recuperarla más adelante desde prendas retiradas.</p><footer><button disabled="@IsBusy" class="secondary" @onclick="CancelRemoval">Cancelar</button><button disabled="@IsBusy" class="danger" @onclick="ConfirmRemovalAsync">Retirar</button></footer></section></div> }
}

@code {
    private readonly Input input = new(); private readonly Dictionary<Guid, string> photoUrls = []; private Guid? pendingRemovalId; private bool showForm; private string search = string.Empty; private ClothingType? selectedType; private ClothingItem? selectedItem;
    [Parameter] public bool IsActive { get; set; } [Parameter] public bool IsBusy { get; set; } [Parameter, EditorRequired] public IReadOnlyList<ClothingItem> Items { get; set; } = []; [Parameter, EditorRequired] public IReadOnlyList<ClothingItem> DeletedItems { get; set; } = []; [Parameter, EditorRequired] public IReadOnlyList<FamilyProfile> Profiles { get; set; } = []; [Parameter, EditorRequired] public EventCallback<(string Name, string Color, Guid OwnerId, ClothingType Type, int WeightGrams)> Created { get; set; } [Parameter, EditorRequired] public EventCallback<(ClothingItem Item, bool Clean, bool Available)> Changed { get; set; } [Parameter, EditorRequired] public EventCallback<Guid> Removed { get; set; } [Parameter, EditorRequired] public EventCallback<Guid> Restored { get; set; } [Parameter, EditorRequired] public EventCallback<(Guid ItemId, IBrowserFile File)> PhotoSelected { get; set; }
    private IReadOnlyList<ClothingItem> GetVisibleItems() => Items.Where(item => (selectedType is null || item.Type == selectedType) && (string.IsNullOrWhiteSpace(search) || item.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || item.Color.Contains(search, StringComparison.OrdinalIgnoreCase))).ToArray();
    private void OpenCreate() => showForm = true; private void CloseCreate() => showForm = false; private void CloseDetails() => selectedItem = null;
    private async Task SaveAsync() { await Created.InvokeAsync((input.Name, input.Color, input.OwnerId, input.Type, input.WeightGrams)); input.Name = string.Empty; input.Color = string.Empty; showForm = false; }
    private async Task ChangeItemAsync(ClothingItem item, bool clean, bool available) => await Changed.InvokeAsync((item, clean, available)); private async Task UploadPhotoAsync(Guid itemId, InputFileChangeEventArgs args) => await PhotoSelected.InvokeAsync((itemId, args.File)); private void RequestRemoval(Guid itemId) { selectedItem = null; pendingRemovalId = itemId; } private void CancelRemoval() => pendingRemovalId = null; private async Task ConfirmRemovalAsync() { if (pendingRemovalId is Guid id) { pendingRemovalId = null; await Removed.InvokeAsync(id); } }
    public void SetPhotoUrl(Guid itemId, string url) => photoUrls[itemId] = url; private void ApplyDefaultWeight() => input.WeightGrams = DefaultWeight(input.Type);
    private static int DefaultWeight(ClothingType type) => type switch { ClothingType.TShirt => 180, ClothingType.Trousers => 500, ClothingType.Shorts => 250, ClothingType.Jacket => 800, ClothingType.Shoes => 900, ClothingType.Sandals => 450, _ => 100 };
    private static string TypeName(ClothingType type) => type switch { ClothingType.TShirt => "Camiseta", ClothingType.Trousers => "Pantalón", ClothingType.Shorts => "Pantalón corto", ClothingType.Jacket => "Chaqueta", ClothingType.Shoes => "Zapatos", ClothingType.Sandals => "Sandalias", _ => "Accesorio" }; private static string GarmentIcon(ClothingType type) => type switch { ClothingType.TShirt => "👕", ClothingType.Trousers => "👖", ClothingType.Shorts => "🩳", ClothingType.Jacket => "🧥", ClothingType.Shoes => "👟", ClothingType.Sandals => "🩴", _ => "🧢" }; private static string ColorStyle(string color) => $"background-color:{color}"; private string OwnerName(Guid? ownerId) => Profiles.FirstOrDefault(profile => profile.Id == ownerId)?.Name ?? "Sin asignar";
    private sealed class Input { public string Name { get; set; } = string.Empty; public string Color { get; set; } = string.Empty; public Guid OwnerId { get; set; } public ClothingType Type { get; set; } = ClothingType.TShirt; public int WeightGrams { get; set; } = 180; }
}
