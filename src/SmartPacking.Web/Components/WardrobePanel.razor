@using SmartPacking.Domain
@using Microsoft.AspNetCore.Components.Forms

@if (IsActive)
{
    <section class="wardrobe">
        @if (IsLoading) { <p class="panel-status" role="status">Actualizando tu armario…</p> }
        @if (!string.IsNullOrWhiteSpace(Feedback)) { <p class="panel-status error" role="alert">@Feedback</p> }
        <header class="page-section-header">
            <div><p class="type">Tu colección</p><h1>Mi armario</h1><p class="muted">Elige prendas disponibles y mantenlas listas para cada viaje.</p></div>
            <button type="button" disabled="@(IsBusy || isAnalyzing)" @onclick="OpenCreate">+ Añadir prenda</button>
        </header>
        @if (AiUsage is not null)
        {
            <p class="muted" role="status">IA · Plan @AiUsage.Plan: @AiUsage.Remaining reconocimientos disponibles (@AiUsage.CreditBalance créditos). @if (AiUsage.IsNearLimit) { <strong>Estás cerca del límite mensual.</strong> }</p>
        }
        <GarmentRecognitionPreview IsAnalyzing="isAnalyzing" />
        <WardrobeFilters Search="search" SearchChanged="value => search = value" SelectedType="selectedType" SelectedTypeChanged="value => selectedType = value" />
        <div class="garment-grid">
            @foreach (var item in GetVisibleItems())
            {
                <button type="button" class="garment-card" @onclick="() => selectedItem = item" aria-label="Ver detalles de @item.Name">
                    @if (photoUrls.TryGetValue(item.Id, out var uploadedPhotoUrl) || !string.IsNullOrWhiteSpace(item.PhotoUrl)) { <img src="@(uploadedPhotoUrl ?? item.PhotoUrl)" alt="@item.Name" /> } else { <span class="garment-placeholder" aria-hidden="true">@GarmentIcon(item.Type)</span> }
                    <span class="garment-details"><strong>@item.Name</strong><small><i style="@ColorStyle(item.Color)"></i>@item.Color</small><small>@TypeName(item.Type) · @item.WeightGrams g</small></span>
                    @if (item.IsClean && item.IsAvailable) { <span class="status-chip ready">Lista</span> } else { <span class="status-chip muted-chip">Revisar</span> }
                </button>
            }
        </div>
        @if (Items.Count == 0) { <section class="wardrobe-empty-state"><span aria-hidden="true">👕</span><div><p class="type">Tu armario empieza aquí</p><h2>Aún no has añadido prendas</h2><p>Guarda las prendas que usas y SmartPacking podrá recomendar qué llevar con más precisión.</p><button type="button" disabled="@(IsBusy || isAnalyzing)" @onclick="OpenCreate">Añadir mi primera prenda</button></div></section> }
        else if (GetVisibleItems().Length == 0) { <section class="empty-filter-state"><p>No hay prendas que coincidan con esta búsqueda.</p><button type="button" class="secondary" @onclick="ClearFilters">Limpiar filtros</button></section> }
    </section>
    @if (DeletedItems.Count > 0) { <details class="archive-section"><summary>Prendas retiradas (@DeletedItems.Count)</summary><div class="archive-items">@foreach (var item in DeletedItems) { <span>@item.Name <button disabled="@IsBusy" @onclick="() => Restored.InvokeAsync(item.Id)">Recuperar</button></span> }</div></details> }
    @if (showForm)
    {
        <div class="ui-modal-backdrop" @onclick="CloseCreate">
            <section class="ui-modal garment-editor-modal" role="dialog" aria-modal="true" aria-labelledby="new-garment-title" @onclick:stopPropagation="true">
                <header><div><p class="type">Nuevo artículo</p><h2 id="new-garment-title">Añadir prenda</h2></div><button type="button" class="icon-button" @onclick="CloseCreate" aria-label="Cerrar">×</button></header>
                <EditForm Model="input" OnValidSubmit="SaveAsync" OnInvalidSubmit="CaptureValidationErrors" class="modal-form structured-form garment-editor-form">
                    <DataAnnotationsValidator />
                    <p class="form-intro">Añade una foto si quieres una propuesta automática; siempre podrás ajustar todos los detalles antes de guardar.</p>
                    <fieldset><legend>La prenda</legend><div class="form-field-grid"><label>Nombre <InputText @bind-Value="input.Name" /><ValidationMessage Field="Name" Errors="fieldErrors" /></label><label>Propietario <select @bind="input.OwnerId">@foreach (var profile in Profiles.Where(profile => !profile.IsArchived)) { <option value="@profile.Id">@profile.Name</option> }</select></label><label>Tipo <select @bind="input.Type" @bind:after="ApplyDefaultWeight">@foreach (var type in Enum.GetValues<ClothingType>()) { <option value="@type">@TypeName(type)</option> }</select></label><label>Color <InputText @bind-Value="input.Color" /><ValidationMessage Field="Color" Errors="fieldErrors" /></label></div></fieldset>
                    <fieldset><legend>Características</legend><div class="form-field-grid"><label>Material <InputText @bind-Value="input.Material" placeholder="Algodón, lana, poliéster…" /></label><label>Temporada <select @bind="input.Season">@foreach (var season in Enum.GetValues<Season>()) { <option value="@season">@season</option> }</select></label><label>Estilo <select @bind="input.Style">@foreach (var style in Enum.GetValues<Style>()) { <option value="@style">@StyleName(style)</option> }</select></label><label>Peso aproximado (g) <InputNumber @bind-Value="input.WeightGrams" /><ValidationMessage Field="WeightGrams" Errors="fieldErrors" /></label></div></fieldset>
                    <fieldset class="garment-photo-section"><legend>Foto y reconocimiento</legend><label class="garment-recognition-field">Foto de la prenda <small>JPEG · hasta 5 MB · la propuesta se aplica al editor para que la revises.</small><InputFile OnChange="SelectNewPhoto" accept="image/jpeg" disabled="@isAnalyzing" /></label>
                    @if (!string.IsNullOrWhiteSpace(newPhotoPreview)) { <img class="garment-upload-preview" src="@newPhotoPreview" alt="Vista previa de la prenda seleccionada" /> }
                    <GarmentRecognitionPreview IsAnalyzing="isAnalyzing" Error="@recognitionError" HasProposal="@(newPhoto is not null && RecognitionRequested is not null && string.IsNullOrWhiteSpace(recognitionError))" /></fieldset>
                    <footer class="form-actions-sticky"><button type="button" class="secondary" disabled="@(IsBusy || isAnalyzing)" @onclick="CloseCreate">Cancelar</button><button disabled="@(IsBusy || isAnalyzing)">@SaveButtonText()</button></footer>
                </EditForm>
            </section>
        </div>
    }
    @if (selectedItem is not null) { var item = selectedItem; <div class="ui-modal-backdrop" @onclick="CloseDetails"><section class="ui-modal garment-modal" role="dialog" aria-modal="true" aria-labelledby="garment-detail-title" @onclick:stopPropagation="true"><header><div><p class="type">@TypeName(item.Type)</p><h2 id="garment-detail-title">@item.Name</h2></div><button type="button" class="icon-button" @onclick="CloseDetails" aria-label="Cerrar">×</button></header><div class="garment-detail-content">@if (photoUrls.TryGetValue(item.Id, out var uploadedPhotoUrl) || !string.IsNullOrWhiteSpace(item.PhotoUrl)) { <img src="@(uploadedPhotoUrl ?? item.PhotoUrl)" alt="@item.Name" /> } else { <span class="garment-detail-placeholder" aria-hidden="true">@GarmentIcon(item.Type)</span> }<dl><div><dt>Color</dt><dd>@item.Color</dd></div><div><dt>Peso</dt><dd>@item.WeightGrams g</dd></div><div><dt>Temporada</dt><dd>@item.Season</dd></div><div><dt>Propietario</dt><dd>@OwnerName(item.OwnerProfileId)</dd></div></dl><div class="garment-toggles"><label><input type="checkbox" checked="@item.IsClean" @onchange="args => ChangeItemAsync(item, args.Value is bool value && value, item.IsAvailable)" /> Limpia</label><label><input type="checkbox" checked="@item.IsAvailable" @onchange="args => ChangeItemAsync(item, item.IsClean, args.Value is bool value && value)" /> Disponible</label></div><label class="photo-upload">Actualizar foto <InputFile OnChange="file => UploadPhotoAsync(item.Id, file)" accept="image/jpeg" /></label><button disabled="@IsBusy" class="danger" @onclick="() => RequestRemoval(item.Id)">Retirar del armario</button></div></section></div> }
    @if (pendingRemovalId is Guid) { <div class="ui-modal-backdrop"><section class="ui-modal confirmation-modal" role="alertdialog"><h2>¿Retirar esta prenda?</h2><p>Podrás recuperarla más adelante desde prendas retiradas.</p><footer><button disabled="@IsBusy" class="secondary" @onclick="CancelRemoval">Cancelar</button><button disabled="@IsBusy" class="danger" @onclick="ConfirmRemovalAsync">Retirar</button></footer></section></div> }
}

@* Code moved to WardrobePanel.razor.cs
    private readonly Input input = new();
    private readonly Dictionary<Guid, string> photoUrls = [];
    private IBrowserFile? newPhoto;
    private string? recognitionError;
    private bool isAnalyzing;
    private Guid? pendingRemovalId;
    private bool showForm;
    private string search = string.Empty;
    private ClothingType? selectedType;
    private ClothingItem? selectedItem;

    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ClothingItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ClothingItem> DeletedItems { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<FamilyProfile> Profiles { get; set; } = [];
    [Parameter, EditorRequired] public EventCallback<(string Name, string Color, Guid OwnerId, ClothingType Type, Season Season, Style Style, string? Material, int WeightGrams, IBrowserFile? File)> Created { get; set; }
    [Parameter] public Func<IBrowserFile, Task<GarmentRecognitionSuggestion>>? RecognitionRequested { get; set; }
    [Parameter, EditorRequired] public EventCallback<(ClothingItem Item, bool Clean, bool Available)> Changed { get; set; }
    [Parameter, EditorRequired] public EventCallback<Guid> Removed { get; set; }
    [Parameter, EditorRequired] public EventCallback<Guid> Restored { get; set; }
    [Parameter, EditorRequired] public EventCallback<(Guid ItemId, IBrowserFile File)> PhotoSelected { get; set; }

    private IReadOnlyList<ClothingItem> GetVisibleItems() => Items.Where(item =>
        (selectedType is null || item.Type == selectedType)
        && (string.IsNullOrWhiteSpace(search)
            || item.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
            || item.Color.Contains(search, StringComparison.OrdinalIgnoreCase))).ToArray();

    private void OpenCreate() => showForm = true;
    private void CloseCreate() => showForm = false;
    private void CloseDetails() => selectedItem = null;

    private async Task SaveAsync()
    {
        await Created.InvokeAsync((input.Name, input.Color, input.OwnerId, input.Type, input.Season, input.Style, string.IsNullOrWhiteSpace(input.Material) ? null : input.Material.Trim(), input.WeightGrams, newPhoto));
        input.Name = string.Empty;
        input.Color = string.Empty;
        input.Material = string.Empty;
        newPhoto = null;
        showForm = false;
    }

    private async Task SelectNewPhoto(InputFileChangeEventArgs args)
    {
        newPhoto = args.File;
        recognitionError = null;
        if (RecognitionRequested is null) return;

        isAnalyzing = true;
        try { ApplyRecognition(await RecognitionRequested(newPhoto)); }
        catch (Exception) { recognitionError = "No se pudo reconocer la prenda. Puedes completar los campos manualmente."; }
        finally { isAnalyzing = false; }
    }

    private void ApplyRecognition(GarmentRecognitionSuggestion suggestion)
    {
        input.Color = suggestion.Color;
        input.Material = suggestion.Material ?? string.Empty;
        input.WeightGrams = suggestion.EstimatedWeightGrams;
        input.Season = GetSeason(suggestion.Seasons);
        input.Style = GetStyle(suggestion.Style);
        input.Name = string.IsNullOrWhiteSpace(input.Name) ? suggestion.Category : input.Name;
    }

    private static Season GetSeason(IReadOnlyCollection<string> seasons) => seasons switch
    {
        _ when seasons.Contains("Verano") => Season.Summer,
        _ when seasons.Contains("Invierno") => Season.Winter,
        _ => Season.MidSeason,
    };

    private static Style GetStyle(string style) => style switch
    {
        "Formal" => Style.Formal,
        "Deportivo" => Style.Sport,
        _ => Style.Casual,
    };
    private async Task ChangeItemAsync(ClothingItem item, bool clean, bool available) => await Changed.InvokeAsync((item, clean, available));
    private async Task UploadPhotoAsync(Guid itemId, InputFileChangeEventArgs args) => await PhotoSelected.InvokeAsync((itemId, args.File));
    private void RequestRemoval(Guid itemId) { selectedItem = null; pendingRemovalId = itemId; }
    private void CancelRemoval() => pendingRemovalId = null;
    private async Task ConfirmRemovalAsync() { if (pendingRemovalId is Guid id) { pendingRemovalId = null; await Removed.InvokeAsync(id); } }
    public void SetPhotoUrl(Guid itemId, string url) => photoUrls[itemId] = url;
    private void ApplyDefaultWeight() => input.WeightGrams = DefaultWeight(input.Type);
    private static int DefaultWeight(ClothingType type) => type switch { ClothingType.TShirt => 180, ClothingType.Shirt => 220, ClothingType.Sweater => 450, ClothingType.Hoodie => 550, ClothingType.Coat => 1200, ClothingType.Dress => 350, ClothingType.Skirt => 220, ClothingType.Underwear => 80, ClothingType.Socks => 60, ClothingType.Swimwear => 120, ClothingType.Pyjamas => 350, ClothingType.Belt => 180, ClothingType.Bag => 500, ClothingType.Trousers => 500, ClothingType.Shorts => 250, ClothingType.Jacket => 800, ClothingType.Shoes => 900, ClothingType.Sandals => 450, _ => 100 };
    private static string TypeName(ClothingType type) => type switch { ClothingType.TShirt => "Camiseta", ClothingType.Shirt => "Camisa", ClothingType.Sweater => "Jersey", ClothingType.Hoodie => "Sudadera", ClothingType.Coat => "Abrigo", ClothingType.Dress => "Vestido", ClothingType.Skirt => "Falda", ClothingType.Underwear => "Ropa interior", ClothingType.Socks => "Calcetines", ClothingType.Swimwear => "Bañador", ClothingType.Pyjamas => "Pijama", ClothingType.Belt => "Cinturón", ClothingType.Bag => "Bolso", ClothingType.Trousers => "Pantalón", ClothingType.Shorts => "Pantalón corto", ClothingType.Jacket => "Chaqueta", ClothingType.Shoes => "Zapatos", ClothingType.Sandals => "Sandalias", _ => "Accesorio" };
    private static string GarmentIcon(ClothingType type) => type switch { ClothingType.TShirt or ClothingType.Shirt => "👕", ClothingType.Trousers => "👖", ClothingType.Shorts => "🩳", ClothingType.Jacket or ClothingType.Coat => "🧥", ClothingType.Sweater or ClothingType.Hoodie => "🧶", ClothingType.Dress or ClothingType.Skirt => "👗", ClothingType.Shoes => "👟", ClothingType.Sandals => "🩴", ClothingType.Socks => "🧦", ClothingType.Bag => "👜", _ => "🧢" };
    private static string ColorStyle(string color) => $"background-color:{color}";
    private string OwnerName(Guid? ownerId) => Profiles.FirstOrDefault(profile => profile.Id == ownerId)?.Name ?? "Sin asignar";

    private sealed class Input
    {
        public string Name { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
        public string Material { get; set; } = string.Empty;
        public Guid OwnerId { get; set; }
        public ClothingType Type { get; set; } = ClothingType.TShirt;
        public Season Season { get; set; } = Season.AllYear;
        public Style Style { get; set; } = Style.Casual;
        public int WeightGrams { get; set; } = 180;
    }
