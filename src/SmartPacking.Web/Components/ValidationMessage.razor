@if (Errors.TryGetValue(Field, out var messages))
{
    foreach (var message in messages)
    {
        <p class="field-validation-error" role="alert">@message</p>
    }
}

@code {
    [Parameter, EditorRequired] public string Field { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, string[]> Errors { get; set; } = new Dictionary<string, string[]>();
}
