@if (IsAnalyzing)
{
    <p class="muted" role="status">Analizando foto…</p>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <p class="feedback error" role="alert">@Error</p>
}
else if (HasProposal)
{
    <p class="muted">Propuesta de Gemini aplicada. Revísala antes de guardar.</p>
}

@code {
    [Parameter] public bool IsAnalyzing { get; set; }
    [Parameter] public bool HasProposal { get; set; }
    [Parameter] public string? Error { get; set; }
}
