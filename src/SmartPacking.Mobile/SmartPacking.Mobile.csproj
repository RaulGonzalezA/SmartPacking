<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SmartPacking.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>SmartPacking</ApplicationTitle>
    <ApplicationId>app.smartpacking.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="..\SmartPacking.Client\SmartPacking.Client.csproj" />
    <ProjectReference Include="..\SmartPacking.Application\SmartPacking.Application.csproj" />
    <ProjectReference Include="..\SmartPacking.Domain\SmartPacking.Domain.csproj" />
  </ItemGroup>
</Project>
