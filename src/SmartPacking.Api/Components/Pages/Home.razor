@page "/"
@rendermode InteractiveServer
@inject IWebSmartPackingClient Api

<main>
    <p class="eyebrow">TU ARMARIO · TU VIAJE · TU MALETA</p>
    <h1>Maleta Inteligente</h1>

    <nav class="tabs" aria-label="Secciones">
        @foreach (var tab in Tabs)
        {
            <button class="tab @(activeTab == tab.Key ? "active" : "")" @onclick="() => activeTab = tab.Key">@tab.Value</button>
        }
    </nav>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <p class="feedback">@feedback</p>
    }

    @if (activeTab == "trips")
    {
        <section class="controls">
            <label>Viaje activo <select @bind="selectedTripId" @bind:after="LoadTripAsync">@foreach (var trip in trips) { <option value="@trip.Id">@trip.Destination · @trip.StartDate</option> }</select></label>
            <button @onclick="() => showTripForm = !showTripForm">Nuevo viaje</button>
            <button class="danger" @onclick="DeleteTripAsync">Eliminar viaje</button>
        </section>
        @if (showTripForm)
        {
            <EditForm Model="newTrip" OnValidSubmit="CreateTripAsync" class="entry-form"><DataAnnotationsValidator />
                <label>Destino <InputText @bind-Value="newTrip.Destination" /></label><label>Salida <InputDate @bind-Value="newTrip.StartDate" /></label><label>Regreso <InputDate @bind-Value="newTrip.EndDate" /></label>
                <label>Mínima °C <InputNumber @bind-Value="newTrip.MinimumTemperatureCelsius" /></label><label>Máxima °C <InputNumber @bind-Value="newTrip.MaximumTemperatureCelsius" /></label><button>Crear viaje</button>
            </EditForm>
        }
        <section class="family-section"><h2>Viajeros</h2><p class="muted">Cada viajero conserva su propia maleta.</p>
            <div class="profile-items">@foreach (var profile in profiles) { <label class="profile-item"><input type="checkbox" checked="@tripProfileIds.Contains(profile.Id)" @onchange="args => SetTraveller(profile.Id, args.Value)" /> @profile.Name</label> }</div>
            <button @onclick="SaveTravellersAsync">Guardar viajeros</button>
        </section>
    }

    @if (activeTab == "wardrobe")
    {
        <section class="wardrobe"><div class="section-heading"><h2>Mi armario</h2><button @onclick="() => showClothingForm = !showClothingForm">Añadir prenda</button></div>
            @if (showClothingForm)
            {
                <EditForm Model="newClothing" OnValidSubmit="CreateClothingAsync" class="entry-form"><label>Nombre <InputText @bind-Value="newClothing.Name" /></label><label>Propietario <select @bind="newClothing.OwnerProfileId">@foreach (var profile in profiles) { <option value="@profile.Id">@profile.Name</option> }</select></label><label>Color <InputText @bind-Value="newClothing.Color" /></label><button>Guardar</button></EditForm>
            }
            <div class="wardrobe-items">@foreach (var item in wardrobe) { <article class="wardrobe-item"><div><strong>@item.Name</strong><span class="wardrobe-meta">@item.Color · @OwnerName(item.OwnerProfileId)</span></div><label><input type="checkbox" checked="@item.IsClean" @onchange="args => UpdateStatusAsync(item, args.Value, item.IsAvailable)" /> Limpia</label><label><input type="checkbox" checked="@item.IsAvailable" @onchange="args => UpdateStatusAsync(item, item.IsClean, args.Value)" /> Disponible</label><button class="danger" @onclick="() => DeleteClothingAsync(item.Id)">Retirar</button></article> }</div>
        </section>
        <section class="wardrobe"><h2>Prendas retiradas</h2><div class="wardrobe-items">@foreach (var item in deletedWardrobe) { <article class="wardrobe-item"><strong>@item.Name</strong><button @onclick="() => RestoreClothingAsync(item.Id)">Recuperar</button></article> }</div></section>
    }

    @if (activeTab == "packing" && plan is not null)
    {
        <section class="hero"><div><p>@plan.Plan.Trip.Destination · @plan.Plan.Trip.Days días</p><h2>Maleta de @plan.Profile.Name</h2></div></section>
        <section class="traveller-select"><label>Maleta de <select @bind="selectedProfileId" @bind:after="LoadPlanAsync">@foreach (var profile in tripProfiles) { <option value="@profile.Id">@profile.Name</option> }</select></label></section>
        <section><div class="section-heading"><h2>Preparar la maleta</h2></div><div class="cards">@foreach (var planned in plan.Plan.Items) { <article class="card"><label><input type="checkbox" checked="@planned.IsPacked" @onchange="args => SetPackedAsync(planned, args.Value)" /></label><div><p class="type">@planned.Recommendation.Item.Type</p><h3>@planned.Recommendation.Item.Name</h3><p class="reason">@string.Join(" · ", planned.Recommendation.Reasons)</p></div></article> }</div></section>
    }
</main>

@code {
#pragma warning disable S2681 // Guard clauses are intentionally kept compact in component callbacks.
    private static readonly IReadOnlyDictionary<string, string> Tabs = new Dictionary<string, string> { ["trips"] = "Viajes", ["wardrobe"] = "Armario", ["packing"] = "Maleta" };
    private readonly TripInput newTrip = new();
    private readonly ClothingInput newClothing = new();
    private IReadOnlyList<Trip> trips = [];
    private IReadOnlyList<FamilyProfile> profiles = [];
    private IReadOnlyList<FamilyProfile> tripProfiles = [];
    private IReadOnlyList<ClothingItem> wardrobe = [];
    private IReadOnlyList<ClothingItem> deletedWardrobe = [];
    private ProfileTripPackingPlan? plan;
    private Guid selectedTripId;
    private Guid selectedProfileId;
    private string activeTab = "trips";
    private string? feedback;
    private bool showTripForm;
    private bool showClothingForm;
    private HashSet<Guid> tripProfileIds = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { trips = await Api.GetTripsAsync(CancellationToken.None); profiles = await Api.GetProfilesAsync(CancellationToken.None); wardrobe = await Api.GetWardrobeAsync(false, CancellationToken.None); deletedWardrobe = await Api.GetWardrobeAsync(true, CancellationToken.None); selectedTripId = selectedTripId == Guid.Empty ? trips.FirstOrDefault()?.Id ?? Guid.Empty : selectedTripId; await LoadTripAsync(); }
    private async Task LoadTripAsync()
    {
        if (selectedTripId == Guid.Empty) return;
        tripProfiles = await Api.GetTripProfilesAsync(selectedTripId, CancellationToken.None);
        tripProfileIds = tripProfiles.Select(profile => profile.Id).ToHashSet();
        selectedProfileId = selectedProfileId == Guid.Empty || !tripProfileIds.Contains(selectedProfileId) ? tripProfiles.FirstOrDefault()?.Id ?? Guid.Empty : selectedProfileId;
        await LoadPlanAsync();
    }
    private async Task LoadPlanAsync()
    {
        if (selectedTripId == Guid.Empty || selectedProfileId == Guid.Empty) return;
        plan = await Api.GetProfilePackingListAsync(selectedTripId, selectedProfileId, CancellationToken.None);
    }
    private async Task CreateTripAsync() { await Api.CreateTripAsync(newTrip.Destination, newTrip.StartDate, newTrip.EndDate, newTrip.MinimumTemperatureCelsius, newTrip.MaximumTemperatureCelsius, CancellationToken.None); showTripForm = false; feedback = "Viaje creado."; await LoadAsync(); }
    private async Task DeleteTripAsync() { await Api.DeleteTripAsync(selectedTripId, CancellationToken.None); selectedTripId = Guid.Empty; feedback = "Viaje eliminado."; await LoadAsync(); }
    private void SetTraveller(Guid profileId, object? value) { if (value is bool selected && selected) tripProfileIds.Add(profileId); else tripProfileIds.Remove(profileId); }
    private async Task SaveTravellersAsync() { await Api.SetTripProfilesAsync(selectedTripId, tripProfileIds, CancellationToken.None); feedback = "Viajeros guardados."; await LoadTripAsync(); }
    private async Task CreateClothingAsync() { await Api.CreateClothingAsync(new ClothingItem(Guid.NewGuid(), newClothing.Name, ClothingType.TShirt, Season.AllYear, newClothing.Color, 2, false, Style.Casual, 150, true, true, 70, [], false, newClothing.OwnerProfileId), CancellationToken.None); showClothingForm = false; feedback = "Prenda guardada."; await LoadAsync(); }
    private async Task UpdateStatusAsync(ClothingItem item, object? cleanValue, object? availableValue)
    {
        await Api.UpdateClothingStatusAsync(item.Id, cleanValue is bool clean && clean, availableValue is bool available && available, CancellationToken.None);
        await LoadAsync();
    }
    private async Task DeleteClothingAsync(Guid id) { await Api.DeleteClothingAsync(id, CancellationToken.None); await LoadAsync(); }
    private async Task RestoreClothingAsync(Guid id) { await Api.RestoreClothingAsync(id, CancellationToken.None); await LoadAsync(); }
    private async Task SetPackedAsync(PlannedItem item, object? value)
    {
        if (plan is null) return;
        await Api.SetProfilePackedAsync(plan.Plan.PackingListId, item.Recommendation.Item.Id, value is bool packed && packed, CancellationToken.None);
        await LoadPlanAsync();
    }
    private string OwnerName(Guid? ownerId) => profiles.FirstOrDefault(profile => profile.Id == ownerId)?.Name ?? "Sin asignar";
    private sealed class TripInput { public string Destination { get; set; } = string.Empty; public DateOnly StartDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); public DateOnly EndDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(3)); public int MinimumTemperatureCelsius { get; set; } = 18; public int MaximumTemperatureCelsius { get; set; } = 28; }
    private sealed class ClothingInput { public string Name { get; set; } = string.Empty; public string Color { get; set; } = string.Empty; public Guid OwnerProfileId { get; set; } }
#pragma warning restore S2681
}
